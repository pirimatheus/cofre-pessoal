// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["queryCompiler", "driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Transacao {
  id                  Int      @id @default(autoincrement())
  nome                String
  data                DateTime
  tipo                String
  valor               String
  icone               String
  cor                 String
  userId              String
  pluggyTransactionId String?  @unique

  @@index([userId])
}

model Meta {
  id            Int       @id @default(autoincrement())
  nome          String
  valorAtual    String
  valorObjetivo String
  possuiPrazo   Boolean
  dataLimite    DateTime?
  icone         String
  dataCriacao   DateTime
  userId        String

  @@index([userId])
}

model LimiteOrcamento {
  id        Int    @id @default(autoincrement())
  categoria String
  limite    String
  cor       String
  userId    String

  @@unique([categoria, userId])
  @@index([userId])
}

model UsuarioPin {
  id           Int       @id @default(autoincrement())
  userId       String    @unique
  pinHash      String
  tentativas   Int       @default(0)
  bloqueadoAte DateTime?
  criadoEm     DateTime  @default(now())
}

model DispositivoConfiavel {
  id        Int      @id @default(autoincrement())
  userId    String
  tokenHash String
  criadoEm  DateTime @default(now())
  expiraEm  DateTime

  @@index([userId])
}

model LogLogin {
  id       Int      @id @default(autoincrement())
  userId   String
  ip       String?
  sucesso  Boolean
  criadoEm DateTime @default(now())

  @@index([userId])
}

model ConsentimentoUsuario {
  id       Int      @id @default(autoincrement())
  userId   String   @unique
  aceitoEm DateTime @default(now())
}

model LayoutDashboard {
  id     Int      @id @default(autoincrement())
  userId String   @unique
  ordem  String[] // array de ids dos widgets, na ordem escolhida
}

model Notificacao {
  id       Int      @id @default(autoincrement())
  userId   String
  mensagem String
  lida     Boolean  @default(false)
  criadoEm DateTime @default(now())

  @@index([userId])
}

model PushSubscription {
  id       Int      @id @default(autoincrement())
  userId   String
  endpoint String   @unique
  p256dh   String
  auth     String
  criadoEm DateTime @default(now())

  @@index([userId])
}

model Conta {
  id          Int      @id @default(autoincrement())
  userId      String
  itemId      String // id da conexão no Pluggy
  contaId     String   @unique // id da conta específica no Pluggy
  instituicao String
  tipo        String // ex: "corrente", "poupança", "cartão"
  saldo       String
  ultimaSync  DateTime @default(now())
  criadoEm    DateTime @default(now())

  @@index([userId])
}
